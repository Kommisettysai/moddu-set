{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".write": "auth != null && !data.exists() && newData.child('hostId').val() === auth.uid",
        "lobby": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('hostId').val() === auth.uid",
          "players": {
            "$playerId": {
              ".write": "auth != null && auth.uid === $playerId && (root.child('rooms').child($roomCode).child('lobby').child('status').val() === 'waiting' || (data.exists() && !newData.exists()))"
            }
          }
        },
        "public": {
          ".read": "auth != null && root.child('rooms').child($roomCode).child('lobby').child('players').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('hostId').val() === auth.uid"
        },
        "private": {
          ".read": "auth != null && root.child('rooms').child($roomCode).child('hostId').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('hostId').val() === auth.uid",
          "hands": {
            "$playerId": {
              ".read": "auth != null && (auth.uid === $playerId || root.child('rooms').child($roomCode).child('hostId').val() === auth.uid)"
            }
          },
          "specialRanks": {
            "$playerId": {
              ".read": "auth != null && (auth.uid === $playerId || root.child('rooms').child($roomCode).child('hostId').val() === auth.uid)"
            }
          }
        },
        "actions": {
          ".read": "auth != null && root.child('rooms').child($roomCode).child('hostId').val() === auth.uid",
          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId && root.child('rooms').child($roomCode).child('lobby').child('players').child(auth.uid).exists()"
          }
        },
        "chat": {
          ".read": "auth != null && root.child('rooms').child($roomCode).child('lobby').child('players').child(auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($roomCode).child('lobby').child('players').child(auth.uid).exists() && newData.child('senderId').val() === auth.uid",
            ".validate": "newData.hasChildren(['senderId','senderName','type','text','createdAt']) && newData.child('senderName').val() === root.child('rooms').child($roomCode).child('lobby').child('players').child(auth.uid).child('name').val() && (newData.child('type').val() === 'emoji' || newData.child('type').val() === 'phrase' || newData.child('type').val() === 'text') && newData.child('text').isString() && newData.child('text').val().length <= 100 && newData.child('createdAt').isNumber()"
          }
        },
        "voice": {
          ".read": "auth != null && root.child('rooms').child($roomCode).child('lobby').child('players').child(auth.uid).exists()",
          "participants": {
            "$playerId": {
              ".write": "auth != null && auth.uid === $playerId && root.child('rooms').child($roomCode).child('lobby').child('players').child(auth.uid).exists()"
            }
          },
          "signals": {
            "$fromUid": {
              "$toUid": {
                "$signalId": {
                  ".read": "auth != null && auth.uid === $toUid && root.child('rooms').child($roomCode).child('lobby').child('players').child(auth.uid).exists()",
                  ".write": "auth != null && auth.uid === $fromUid && root.child('rooms').child($roomCode).child('lobby').child('players').child(auth.uid).exists()"
                }
              }
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)"
      }
    },
    "friendRequests": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid",
        "$senderUid": {
          ".read": "auth != null && (auth.uid === $recipientUid || auth.uid === $senderUid)",
          ".write": "auth != null && ((!data.exists() && auth.uid === $senderUid && newData.exists()) || (data.exists() && (auth.uid === $recipientUid || auth.uid === $senderUid)))"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && ((auth.uid === $uid && root.child('friendRequests').child($uid).child($friendUid).exists()) || (auth.uid === $friendUid && root.child('friendRequests').child($friendUid).child($uid).exists()))"
        }
      }
    },
    "roomInvites": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid",
        "$inviteId": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('friends').child(auth.uid).child($recipientUid).exists() && root.child('rooms').child(newData.child('roomCode').val()).child('lobby').child('hostId').val() === auth.uid && root.child('rooms').child(newData.child('roomCode').val()).child('lobby').child('status').val() === 'waiting' && root.child('rooms').child(newData.child('roomCode').val()).child('lobby').child('players').child(auth.uid).exists()) || (auth.uid === $recipientUid && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['roomCode','inviterUid','inviterName','createdAt']) && newData.child('inviterUid').val() === auth.uid && newData.child('roomCode').isString() && newData.child('inviterName').isString() && newData.child('createdAt').isNumber())"
        }
      }
    }
  }
}