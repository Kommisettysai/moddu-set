{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
        "players": {
          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId && ((!newData.exists()) || (newData.child('id').val() === auth.uid && root.child('rooms').child($roomCode).child('status').val() === 'waiting' && root.child('rooms').child($roomCode).child('players').numChildren() < 6))"
          }
        }
      }
    }
  }
}
